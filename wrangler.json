{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aisys-landing",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "routes": [
    {
      "pattern": "aisys.cam/*",
      "zone_name": "aisys.cam"
    },
    {
      "pattern": "www.aisys.cam/*",
      "zone_name": "aisys.cam"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WAITLIST_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ]
}