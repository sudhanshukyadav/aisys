{
  "name": "aisys",
  "main": "worker.js",
  "compatibility_date": "2024-01-01",
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "aisys-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aisys-db",
      "database_id": "d1-database-id-from-dash"
    }
  ]
}
